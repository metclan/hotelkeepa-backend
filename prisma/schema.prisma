// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id String @id @default(uuid())
  name         String         @db.Text
  email         String         @unique
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  emailVerified Boolean        @default(false)
  isActive      Boolean        @default(true)
  onboardingStage Int       @default(1)
  isOwner       Boolean        @default(false)
  phone         String?
  roleId        String?
  locationId    String?
  businessId    String?
  image         String?        @db.Text

  // Relationships
  role  Role? @relation(fields: [roleId], references: [id])
  businessLocation Location? @relation(fields: [locationId], references: [id])
  business         Business? @relation(fields: [businessId], references: [id])
  locationAccess UserLocation[]
  departmentAccess UserDepartment[]
  reservations     Reservation[]
  sessions      Session[]
  accounts      Account[]
  invitations   Invitation[]

  @@map("user")
  
}

model Business {
  id String @id @default(uuid())
  name    String?
  locations Location[]
  currencyId             String?
  countryId              String?

  // Realationships
  subscriptions Subscription[]
  subscriptinoPayments SubscriptionPayment[]
  users         User[]
  customers     Customer[]
  currency               Currency?                 @relation(fields: [currencyId], references: [id])
  country                Country?                @relation(fields: [countryId], references: [id])

  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
}
model Role {
  id String @id @default(uuid())
  name    String
  isAdmin Boolean @default(false)
  locationId String

  // Relations 
  businessLocation Location @relation(fields: [locationId], references: [id], onDelete: Cascade)
  rolePermissions  RolePermission[]
  users       User[]
  invitations Invitation[]
  locationMemberships UserLocation[]

  @@unique([id, locationId])

  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
}
model PermissionGroup {
  id String @id @default(uuid())
  name    String
  code    String @unique
  description String

  // Relationships
  permissions Permission[]

  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
}
model Permission { 
  id String @id @default(uuid())
  code    String @unique
  name    String
  permissionGroupId String
  rolePermissions RolePermission[]
  
  // Relationship 
  permissionGroup PermissionGroup @relation(fields: [permissionGroupId], references: [id], onDelete: Cascade)

  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
}

model RolePermission { 
  id String @id @default(uuid())
  roleId  String
  permissionId  String

  // Relationships
  role  Role @relation(fields: [roleId], references: [id])
  permission Permission @relation(fields: [permissionId], references: [id])

  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@unique([roleId, permissionId])
}
model Location {
  id String @id @default(uuid())
  name       String?
  address    String?
  city       String?
  state      String?
  zip        String?
  phone      String?
  email      String?
  isActive   Boolean @default(true)
  isDeleted  Boolean @default(false)
  businessId String
  timezone String @default("Africa/Lagos")
  // Public R2 URL; image bytes are never persisted here.
  logo String? @db.MediumText
  logoKey String? @db.VarChar(1024)
  setupPreset HotelSetupPreset @default(reservations_only)
  departments Department[]
  diningTables DiningTable[]
  productCategories ProductCategory[]
  productUnits ProductUnit[]
  products Product[]
  userAccess UserLocation[]
  activeSessions Session[]
  defaultCheckoutTime String @default("12:00") //12:00PM
  defaultCheckinTime  String @default("12:00") //12:00PM 

  // Relations
  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  rooms    Room[]
  roles    Role[]
  users    User[]
  subscriptionPayments SubscriptionPayment[]
  subscriptions Subscription[]
  documentSequences DocumentSequence[]
  reservations  Reservation[]
  customers Customer[]
  roomTypes RoomType[]
  payments  Payment[]
  customLabels           CustomLabels[]
  invitations   Invitation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Constraints 
  @@unique([businessId, name])
}
model CustomLabels {
  id String @id @default(uuid())
  locationId         String
  label              String              @db.VarChar(255)
  type               CustomLabelType
  location           Location            @relation(fields: [locationId], references: [id], onDelete: Cascade)
  isActive           Boolean             @default(true)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @default(now()) @updatedAt

  paymentMethods    PaymentMethodEntry[]
  posOrderPayments PosOrderPayment[]
}
enum CustomLabelType {
  payment
}
model Room {
  id String @id @default(uuid())
  roomNumber         String
  roomTypeId   String
  floor        String?
  locationId   String
  status       RoomStatus @default(available)
  roomType   RoomType   @relation(fields: [roomTypeId], references: [id], onDelete: Cascade)

  // Relations 
  roomLocation Location @relation(fields: [locationId], references: [id], onDelete: Cascade)
  reservationLines  ReservationLine[]

  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@unique([locationId, roomNumber])
}
model RoomType {
  id String @id @default(uuid())
  name         String
  locationId   String
  pricePerNight Decimal @db.Decimal(10,2)
  description  String?
  maxAdults     Int?
  maxChildren   Int?
  maxOccupancy  Int?
  
  // Relations
  roomTypeLocation Location @relation(fields: [locationId], references: [id], onDelete: Cascade)
  rooms  Room[]

  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
}
model Customer { 
  id String @id @default(uuid())
  firstName String
  lastName  String? 
  phone     String
  email     String?
  locationId  String
  businessId String
  address   String? 
  gender    Gender? 
  idType    String? 
  idNumber  String? 
  nationality String? 
  occupation  String? 
  dateOfBirth DateTime?
  isWalking  Boolean @default(false)
  isActive    Boolean @default(true)
  isDeleted   Boolean @default(false)

  // Relationships
  location  Location @relation(fields: [locationId], references: [id], onDelete: Cascade)
  business  Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  reservations  Reservation[]

  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  
}
model Reservation {
  id String @id @default(uuid())
  customerId  String
  locationId  String
  userId     String
  reservationDate DateTime
  arrivalDate     DateTime
  departureDate   DateTime
  totalAmount Decimal @db.Decimal(10,2)
  bookingNumber String?
  paymentStatus PaymentStatus
  notes      String?

  // Relationships
  location Location @relation(fields: [locationId], references: [id], onDelete: Cascade)
  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  reservationLines  ReservationLine[]

  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
}
model ReservationLine {
  id String @id @default(uuid())
  reservationId String 
  roomId        String
  checkInDate   DateTime?
  checkOutDate  DateTime?
  numberOfAdults Int?
  numberOfChildren Int?
  pricePerNight Decimal @db.Decimal(10,2)
  status        ReservationRoomStatus? @default(reserved)

  // Relationships
  room          Room @relation(fields: [roomId], references: [id], onDelete: Cascade)
  reservation   Reservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)

  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
}
model Payment {
  id String @id @default(uuid())
  locationId  String
  contactType ContactType
  contactId   String? // refers to Patient/Supplier/etc
  direction   PaymentDirection
  amount      Decimal             @db.Decimal(10, 2)
  paymentDate DateTime
  reference   String?
  notes       String?
  createdById String

  // Relationships
  locations Location @relation(fields: [locationId], references: [id], onDelete: Cascade)
  allocations PaymentAllocation[]
  paymentMethods  PaymentMethodEntry[]
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  
}

model PaymentMethodEntry {
  id String @id @default(uuid())
  paymentId       String 
  paymentMethodId String 
  amount          Decimal          @db.Decimal(10,2)
  payment         Payment          @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  customLabels    CustomLabels @relation(fields: [paymentMethodId], references: [id])
  @@unique([paymentId, paymentMethodId])
}

model PaymentAllocation {
  id String @id @default(uuid())
  paymentId       String
  transactionType TransactionType
  transactionId   String? 
  amountApplied   Decimal         @db.Decimal(10, 2)
  allocationType  AllocactionType
  payment         Payment         @relation(fields: [paymentId], references: [id], onDelete: Cascade)
}

model DocumentSequence {
  id String @id @default(uuid())
  locationId  String 
  transactionType DocumentType
  currentNumber   Int @default(0)

  // Relationship
  location Location @relation(fields: [locationId], references: [id], onDelete: Cascade)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@unique([locationId, transactionType])
}
model Plan {
  id String @id @default(uuid())
  name         String
  price        Float
  maxUsers     Int?
  maxLocations Int?

  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  subscriptions Subscription[]
}

model Subscription {
  id String @id @default(uuid())
  businessId String
  planId     String
  startDate  DateTime
  endDate    DateTime?
  locationId String?

  // Relations
  business Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  plan     Plan      @relation(fields: [planId], references: [id])
  location Location? @relation(fields: [locationId], references: [id])

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  subcriptionPayments  SubscriptionPayment[]
}

model SubscriptionPayment {
  id String @id @default(uuid())
  subscriptionId    String
  amount            Int
  paidAt            DateTime
  provider          String?
  providerReference String?
  locationId        String?
  status            SubscriptionPaymentStatus @default(PENDING)
  businessId        String

  // Relations
  subscription Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  business     Business     @relation(fields: [businessId], references: [id], onDelete: Cascade)
  location     Location?    @relation(fields: [locationId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
enum SubscriptionPaymentStatus {
  PENDING
  SUCCESS
  FAILED
  REFUNDED
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?  @db.Text
  userAgent String?  @db.Text
  activeLocationId String?
  activeLocation Location? @relation(fields: [activeLocationId], references: [id], onDelete: SetNull)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([userId(length: 191)])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String    @db.Text
  providerId            String    @db.Text
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?   @db.Text
  refreshToken          String?   @db.Text
  idToken               String?   @db.Text
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?   @db.Text
  password              String?   @db.Text
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId(length: 191)], map: "account_userId_idx_new")
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String   @db.Text
  value      String   @db.Text
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier(length: 191)])
  @@map("verification")
}

model Country {
  id String @id @default(uuid())
  name       String     @unique
  code       String     @unique
  phoneCode  String?
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
  businesses Business[]
  currency Currency?
}
model Currency {
  id String @id @default(uuid())
  code       String     @unique
  name       String
  symbol     String
  countryId  String?    @unique
  shortForm  String     @unique
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
  businesses Business[]
  country    Country?    @relation(fields: [countryId], references: [id])
}
model Invitation {
  id String @id @default(uuid())
  email String 
  name String
  token String @unique
  roleId  String 
  locationId  String
  businessId  String 
  invitedById String 
  status  InviteStatus @default(pending)
  expiresAt DateTime
  acceptedAt  DateTime? 

  // Relationships 
  role  Role  @relation(fields: [roleId], references: [id], onDelete: Cascade)
  location Location @relation(fields: [locationId], references: [id], onDelete: Cascade)
  invitedBy User @relation(fields: [invitedById], references: [id], onDelete: Cascade)

  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}
enum InviteStatus { 
  pending 
  accepted 
  expired 
  revoked
}
enum RoomStatus {
  available
  occupied
  reserved
  maintenance
}
enum ReservationRoomStatus {
  reserved
  checked_in
  checked_out
  cancelled
  no_show
}
enum Gender {
  male 
  female
  other
}
enum DocumentType {
  reservation
  sale
  stock_adjustment
  payment
}
enum ContactType {
  customer 
  supplier
}
enum PaymentDirection {
  outgoing
  ingoing
}
enum AllocactionType {
  reservation
  sale
  purchase
}
enum TransactionType {
  reservation
  sale
  purchase
  payment
}
enum PaymentStatus {
  paid
  partially_paid
  due
}

// Presets only seed onboarding; departments remain independently configurable.
enum HotelSetupPreset {
  reservations_only
  reservations_bar
  full_service
}

enum DepartmentAccessRole {
  staff
  manager
}

// User.locationId is the default hotel. Session.activeLocationId overrides it per session.
model UserLocation {
  userId String
  locationId String
  isActive Boolean @default(true)
  // False means this member is restricted to explicit UserDepartment assignments.
  allDepartments Boolean @default(false)
  roleId String?
  role Role? @relation(fields: [roleId, locationId], references: [id, locationId], onDelete: Restrict)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  location Location @relation(fields: [locationId], references: [id], onDelete: Restrict)
  departments UserDepartment[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@id([userId, locationId])
  @@index([locationId])
}

model Department {
  id String @id @default(uuid())
  locationId String
  name String
  holdsInventory Boolean @default(false)
  canSell Boolean @default(false)
  managesTables Boolean @default(false)
  kitchenOrders Boolean @default(false)
  isActive Boolean @default(true)
  disabledAt DateTime?
  invoiceHeading String?
  invoicePrefix String?
  location Location @relation(fields: [locationId], references: [id], onDelete: Restrict)
  users UserDepartment[]
  tables DiningTable[]
  productInventory ProductInventory[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([locationId, name])
  @@unique([id, locationId])
  @@index([locationId, isActive])
}

model DiningTable {
  id String @id @default(uuid())
  locationId String
  departmentId String
  name String
  isActive Boolean @default(true)
  location Location @relation(fields: [locationId], references: [id], onDelete: Restrict)
  department Department @relation(fields: [departmentId, locationId], references: [id, locationId], onDelete: Restrict)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([departmentId, name])
  @@index([locationId, isActive])
  @@index([departmentId, isActive])
}

model ProductCategory {
  id String @id @default(uuid())
  locationId String
  name String
  location Location @relation(fields: [locationId], references: [id], onDelete: Restrict)
  products Product[]
  @@unique([locationId, name])
  @@unique([id, locationId])
}

model ProductUnit {
  id String @id @default(uuid())
  locationId String
  name String
  symbol String @db.VarChar(30)
  location Location @relation(fields: [locationId], references: [id], onDelete: Restrict)
  products Product[]
  @@unique([locationId, name])
  @@unique([id, locationId])
}

model Product {
  id String @id @default(uuid())
  locationId String
  businessId String
  disabledAt DateTime?
  archivedSku String?
  name String
  sku String?
  categoryId String?
  unitId String
  costPrice Decimal @db.Decimal(14, 2)
  reorderQuantity Decimal @db.Decimal(14, 3)
  location Location @relation(fields: [locationId], references: [id], onDelete: Restrict)
  category ProductCategory? @relation(fields: [categoryId, locationId], references: [id, locationId], onDelete: Restrict)
  unit ProductUnit @relation(fields: [unitId, locationId], references: [id, locationId], onDelete: Restrict)
  inventory ProductInventory[]
  images ProductImage[]
  @@unique([businessId, sku])
  @@unique([id, locationId])
  @@index([locationId, disabledAt])
}

model ProductInventory {
  productId String
  departmentId String
  locationId String
  costPrice Decimal @db.Decimal(14, 2)
  sellingPrice Decimal? @db.Decimal(14, 2)
  quantity Decimal @db.Decimal(14, 3)
  batches StockBatch[]
  adjustments ProductStockAdjustment[]
  stockDate DateTime @db.Date
  expiryDate DateTime? @db.Date
  product Product @relation(fields: [productId, locationId], references: [id, locationId], onDelete: Cascade)
  department Department @relation(fields: [departmentId, locationId], references: [id, locationId], onDelete: Restrict)
  @@id([productId, departmentId])
}

model ProductImage {
  id String @id @default(uuid())
  productId String
  key String @db.VarChar(1024)
  url String @db.Text
  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)
  createdAt DateTime @default(now())
}

model StockBatch {
  id String @id @default(uuid())
  productId String
  departmentId String
  quantity Decimal @db.Decimal(14, 3)
  quantityLeft Decimal @db.Decimal(14, 3)
  costPrice Decimal @db.Decimal(14, 2)
  stockDate DateTime @db.Date
  expiryDate DateTime? @db.Date
  inventory ProductInventory @relation(fields: [productId, departmentId], references: [productId, departmentId], onDelete: Restrict)
  movements StockMovement[]
  @@index([productId, departmentId, stockDate])
}

model StockMovement {
  id String @id @default(uuid())
  stockBatchId String
  batch StockBatch @relation(fields: [stockBatchId], references: [id], onDelete: Restrict)
  type StockMovementType
  quantity Decimal @db.Decimal(14, 3)
  unitCost Decimal @db.Decimal(14, 2)
  referenceId String
  reason String
  userId String?
  effectiveDate DateTime @db.Date
  createdAt DateTime @default(now())
  @@index([referenceId])
}

enum StockMovementType {
  opening
  adjustment
  transfer
  purchase
  sale
  adjustment_edited
  adjustment_deleted
}

model ProductStockAdjustment {
  id String @id @default(uuid())
  memoId String
  memo StockAdjustmentMemo @relation(fields: [memoId], references: [id], onDelete: Restrict)
  productId String
  departmentId String
  inventory ProductInventory @relation(fields: [productId, departmentId], references: [productId, departmentId], onDelete: Restrict)
  previousQuantity Decimal @db.Decimal(14, 3)
  newQuantity Decimal @db.Decimal(14, 3)
  reason String
  userId String
  createdAt DateTime @default(now())
  @@index([productId, departmentId, createdAt])
}

model StockAdjustmentMemo {
  id String @id @default(uuid())
  memoNumber String
  deletedAt DateTime?
  effectiveDate DateTime @db.Date
  note String? @db.Text
  lines ProductStockAdjustment[]
}

model PosRegister {
  id String @id @default(uuid())
  number Int @unique @default(autoincrement())
  locationId String
  userId String
  activeKey String? @unique
  openedAt DateTime @default(now())
  closedAt DateTime?
  orders PosOrder[]
}

model PosOrder {
  id String @id @default(uuid())
  registerId String
  register PosRegister @relation(fields: [registerId], references: [id], onDelete: Restrict)
  departmentId String
  tableId String?
  activeTableId String? @unique
  status PosOrderStatus
  receiptNumber String?
  paymentMethodId String?
  changeDue Decimal @default(0) @db.Decimal(14, 2)
  customerId String?
  customerName String?
  items Json
  total Decimal @db.Decimal(14, 2)
  kitchenVersion Int @default(0)
  version Int @default(1)
  kitchenItems Json?
  paymentEntries PosOrderPayment[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([departmentId, status, updatedAt])
}

enum PosOrderStatus {
  held
  paid
  cancelled
}

model PosOrderPayment {
  id String @id @default(uuid())
  orderId String
  paymentMethodId String
  amountReceived Decimal @db.Decimal(14, 2)
  amountApplied Decimal @db.Decimal(14, 2)
  order PosOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  paymentMethod CustomLabels @relation(fields: [paymentMethodId], references: [id], onDelete: Restrict)
  @@unique([orderId, paymentMethodId])
  @@index([paymentMethodId])
}

model UserDepartment {
  userId String
  locationId String
  departmentId String
  role DepartmentAccessRole @default(staff)
  isActive Boolean @default(true)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Composite relations prevent assigning a department from another hotel.
  membership UserLocation @relation(fields: [userId, locationId], references: [userId, locationId], onDelete: Cascade)
  department Department @relation(fields: [departmentId, locationId], references: [id, locationId], onDelete: Restrict)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@id([userId, departmentId])
  @@index([userId, locationId])
  @@index([departmentId, locationId])
}
