# Application
DATABASE_URL=mysql://USER:PASSWORD@HOST:3306/hotelkeepa
BETTER_AUTH_SECRET=replace-with-a-random-secret
BASEURL=http://localhost:5001
FRONTEND_URL=http://localhost:3000
PORT=5001

# Cloudflare R2: dedicated R2 S3 API credentials, never AWS SES credentials
R2_ACCOUNT_ID=
# Optional explicit endpoint, for jurisdiction-specific R2 buckets
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
# Public bucket custom domain (HTTPS); not the private S3 API endpoint
R2_PUBLIC_BASE_URL=

# Amazon SES: verified sender in this AWS region
AWS_REGION=
SES_FROM_EMAIL=Hotelkeepa <hello@example.com>
SES_REPLY_TO_EMAIL=
SES_CONFIGURATION_SET=
# Leave credentials unset when the deployment provides an IAM role.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Temporary AWS credentials only
AWS_SESSION_TOKEN=
